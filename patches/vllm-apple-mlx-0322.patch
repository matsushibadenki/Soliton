+# PyPI0.32.0: same LRU insert/trim/fetch contract, new cache-type accounting.
+# Qualified separately; do not mix server/cache revisions.
+REVIEWED_SOURCE_PAIRS = {
+    "0.32.0": {
+        (SERVER_SHA256, CACHE_SHA256),
+        ('57392576de114af80ede723976b9dd156dc234f856b9943b8b44b8b78bc27f79',
+         'c96cb169fd5e0ec4584a162dd61dc62ab08ccdca03a9850f8a491ce6809145e6'),
+    },
+    # PyPI0.32.2: LRU/Gemma2 bytes unchanged. Text generation and response
+    # transitions reviewed separately; vision is deliberately outside this profile.
+    "0.32.2": {
+        ('8d475058966cf90afcf8cb857f218c2b9dbc01ad1c506d9726de655a90d80723',
+         'c96cb169fd5e0ec4584a162dd61dc62ab08ccdca03a9850f8a491ce6809145e6'),
+    },
+}
+
+
+def reviewed_sources(release, server, cache):
+    return (server, cache) in REVIEWED_SOURCE_PAIRS.get(release, ())
+
+
+def validate_text_messages(messages):
+    """Keep the qualified plain-text surface before 0.32.2 can fetch image URLs."""
+    if not isinstance(messages, list) or not 1 <= len(messages) <= 1000:
+        raise ValueError('retained KV profile requires plain-text messages')
+    for message in messages:
+        if (not isinstance(message, dict) or set(message) != {'role', 'content'}
+                or message['role'] not in ('system', 'user', 'assistant')
+                or not isinstance(message['content'], str)):
+            raise ValueError('retained KV profile requires plain-text messages')
+
+
+def install_text_profile(server, release):
+    if release == '0.32.2':
+        # This function is called by the exactly guarded server before any URL
+        # inlining, inside its request-factory exception -> HTTP400 boundary.
+        server._inline_image_urls = validate_text_messages


