{
  "name": "soliton",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --target aarch64-apple-darwin",
    "server": "cargo run -p studio-server",
    "test:e2e": "node scripts/smoke.mjs",
    "test:roadmap": "node scripts/roadmap-smoke.mjs",
    "test:menus": "node scripts/menus-smoke.mjs",
    "test:models": "node scripts/models-smoke.mjs",
    "test:reuse": "node scripts/reuse-smoke.mjs",
    "test:workspace": "node scripts/workspace-smoke.mjs",
    "test:docking": "node scripts/split-docking-smoke.mjs",
    "test:floating": "node scripts/floating-docking-smoke.mjs",
    "benchmark:inference": "node scripts/benchmark-inference.mjs",
    "test:benchmark": "node --test scripts/benchmark-inference.test.mjs",
    "test:upstream": "python3 scripts/upstream-compatibility.py",
    "test:engines": "node scripts/engines-smoke.mjs",
    "test:real-model": "node scripts/real-model-smoke.mjs",
    "test:token-counter": "python3 scripts/token-counter.test.py",
    "benchmark:token-count": "node scripts/token-count-benchmark.mjs",
    "benchmark:token-count:compare": "node scripts/compare-token-count.mjs",
    "test:context-matrix": "node --test scripts/context-matrix.test.mjs",
    "test:cache-memory": "node --test scripts/cache-memory-workload.test.mjs",
    "bundle:engine": "node scripts/bundle-strata.mjs",
    "bundle:python": "node scripts/bundle-python.mjs",
    "bundle:metal": ".soliton-runtime/python-build/cpython-3.12.16-macos-aarch64-none/bin/python3 scripts/build-bundled-metal.py",
    "check:distribution": ".soliton-runtime/python-build/cpython-3.12.16-macos-aarch64-none/bin/python3 scripts/check-distribution.py",
    "postdesktop:build": "npm run check:distribution",
    "package:validation": "node scripts/package-validation.mjs",
    "benchmark:engine": "node scripts/benchmark-engine-gateway.mjs",
    "test:engine-baseline": "node --test scripts/benchmark-engine-gateway.test.mjs",
    "benchmark:kv-retention": "vLLM-apple/.venv/bin/python scripts/compare-kv-retention.py",
    "test:kv-retention": "python3 scripts/compare-kv-retention.test.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
